<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android displays this while Flutter creates its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#10131B</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Switch away from the launch window as soon as Flutter is attached. -->
    <style name="NormalTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#10131B</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
