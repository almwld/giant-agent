PORT=8080
# Production user authentication: HS256 JWT signing secret (32+ random bytes).
# The issuer signs short-lived tokens with sub, iss, aud and exp claims.
GATEWAY_JWT_SECRET=replace-with-at-least-32-random-bytes
GATEWAY_JWT_ISSUER=https://auth.example.com/
GATEWAY_JWT_AUDIENCE=giant-agent-mobile
# Development-only single-user fallback. Ignored when NODE_ENV=production.
APP_GATEWAY_TOKEN=development-only-change-me
# openrouter | openai | gemini
AI_PROVIDER=openrouter
AI_API_KEY=provider-api-key-goes-here
# OpenRouter automatic routing to an available free model.
AI_MODEL=openrouter/free
ALLOWED_MODELS=openrouter/free
# Gemini: AI_PROVIDER=gemini, AI_MODEL=<model enabled in your AI Studio account>
# OpenAI: AI_PROVIDER=openai, AI_MODEL=<model enabled in your API account>
# Optional provider-compatible endpoint override:
# AI_BASE_URL=https://openrouter.ai/api/v1
RATE_LIMIT_PER_MINUTE=30
MAX_BODY_BYTES=18874368
APP_PUBLIC_URL=https://github.com/almwld/giant-agent
